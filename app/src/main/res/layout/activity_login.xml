<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#F5F4FF">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:background="@drawable/gradient_header"
        android:orientation="vertical" android:gravity="center" android:padding="32dp">
        <LinearLayout android:layout_width="80dp" android:layout_height="80dp"
            android:background="@drawable/card_elevated" android:gravity="center"
            android:layout_marginBottom="20dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🔍" android:textSize="40sp"/>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Welcome Back" android:textSize="30sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Sign in to continue your search" android:textSize="14sp"
            android:textColor="#FFFFFFCC" android:paddingTop="8dp"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.5">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="#FFFFFF" android:padding="28dp"
            android:layout_margin="16dp" android:elevation="4dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Email" android:textSize="13sp" android:textColor="#6C63FF"
                android:textStyle="bold" android:paddingBottom="8dp"/>
            <EditText android:id="@+id/etEmail" android:layout_width="match_parent" android:layout_height="56dp"
                android:hint="your@email.com" android:inputType="textEmailAddress"
                android:paddingHorizontal="18dp" android:background="@drawable/input_modern"
                android:textSize="15sp" android:layout_marginBottom="20dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Password" android:textSize="13sp" android:textColor="#6C63FF"
                android:textStyle="bold" android:paddingBottom="8dp"/>
            <FrameLayout android:layout_width="match_parent" android:layout_height="56dp"
                android:layout_marginBottom="12dp">
                <EditText android:id="@+id/etPassword" android:layout_width="match_parent" android:layout_height="56dp"
                    android:hint="••••••••" android:inputType="textPassword"
                    android:paddingHorizontal="18dp" android:paddingEnd="48dp" android:background="@drawable/input_modern"
                    android:textSize="15sp"/>
                <TextView android:id="@+id/tvTogglePassword" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="14dp" android:text="👁" android:textSize="18sp"
                    android:padding="6dp"/>
            </FrameLayout>
            <TextView android:id="@+id/tvForgotPassword" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Forgot Password?"
                android:textSize="13sp" android:textColor="#FF6584" android:textStyle="bold"
                android:layout_gravity="end" android:paddingBottom="24dp"/>
            <Button android:id="@+id/btnLogin" android:layout_width="match_parent" android:layout_height="58dp"
                android:text="Sign In" android:background="@drawable/btn_purple" android:textColor="#FFFFFF"
                android:textSize="16sp" android:textStyle="bold" android:layout_marginBottom="20dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="New here? " android:textSize="14sp" android:textColor="#888"/>
                <TextView android:id="@+id/tvRegister" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Create account"
                    android:textSize="14sp" android:textColor="#6C63FF" android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
