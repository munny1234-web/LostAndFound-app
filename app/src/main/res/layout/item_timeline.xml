<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp"
    android:background="@drawable/chip_default">

    <LinearLayout android:layout_width="10dp" android:layout_height="10dp"
        android:background="@drawable/circle_purple" android:layout_marginEnd="14dp"/>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tvTimelineStatus" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="14sp"
            android:textStyle="bold" android:textColor="#1A1A2E"/>
        <TextView android:id="@+id/tvTimelineTime" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="11sp"
            android:textColor="#9B8EC4" android:paddingTop="2dp"/>
    </LinearLayout>

</LinearLayout>
