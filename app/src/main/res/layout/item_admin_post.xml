<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/card_elevated" android:orientation="vertical" android:padding="14dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <ImageView android:id="@+id/imgAdminPost" android:layout_width="70dp" android:layout_height="70dp"
            android:scaleType="centerCrop" android:background="@drawable/chip_default" android:layout_marginEnd="12dp"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="6dp">
                <TextView android:id="@+id/tvAdminPostType" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="LOST" android:textSize="10sp" android:textStyle="bold" android:textColor="#FF4444"
                    android:background="@drawable/tag_lost" android:paddingHorizontal="8dp" android:paddingVertical="2dp"
                    android:layout_marginEnd="8dp"/>
                <TextView android:id="@+id/tvAdminPostCategory" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:textSize="11sp" android:textColor="#9B8EC4"/>
            </LinearLayout>
            <TextView android:id="@+id/tvAdminPostTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="15sp" android:textStyle="bold" android:textColor="#1A1A2E" android:paddingBottom="4dp"/>
            <TextView android:id="@+id/tvAdminPostMeta" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="#888"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingTop="10dp">
        <Button android:id="@+id/btnAdminEditPost" android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1" android:text="✏️ Edit" android:textSize="12sp" android:textColor="#FFFFFF"
            android:background="@drawable/btn_purple" android:layout_marginEnd="8dp"/>
        <Button android:id="@+id/btnAdminDeletePost" android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1" android:text="🗑️ Delete" android:textSize="12sp" android:textColor="#FF4444"
            android:backgroundTint="#FFF0F0"/>
    </LinearLayout>
</LinearLayout>
