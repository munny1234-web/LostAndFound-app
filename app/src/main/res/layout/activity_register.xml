<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#F5F4FF">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/gradient_header" android:padding="24dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/tvLogin" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="←" android:textSize="26sp" android:textColor="#FFFFFF" android:paddingEnd="16dp"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Create Account" android:textSize="24sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Join the community" android:textSize="13sp" android:textColor="#FFFFFFCC"/>
        </LinearLayout>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/card_elevated" android:orientation="vertical"
                android:padding="24dp" android:elevation="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Full Name" android:textSize="13sp" android:textColor="#6C63FF"
                    android:textStyle="bold" android:paddingBottom="8dp"/>
                <EditText android:id="@+id/etName" android:layout_width="match_parent" android:layout_height="56dp"
                    android:hint="John Doe" android:inputType="textPersonName"
                    android:paddingHorizontal="18dp" android:background="@drawable/input_modern"
                    android:layout_marginBottom="20dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Email Address" android:textSize="13sp" android:textColor="#6C63FF"
                    android:textStyle="bold" android:paddingBottom="8dp"/>
                <EditText android:id="@+id/etEmail" android:layout_width="match_parent" android:layout_height="56dp"
                    android:hint="your@email.com" android:inputType="textEmailAddress"
                    android:paddingHorizontal="18dp" android:background="@drawable/input_modern"
                    android:layout_marginBottom="20dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Phone Number" android:textSize="13sp" android:textColor="#6C63FF"
                    android:textStyle="bold" android:paddingBottom="8dp"/>
                <EditText android:id="@+id/etPhone" android:layout_width="match_parent" android:layout_height="56dp"
                    android:hint="+880 1X XX XXX XXX" android:inputType="phone"
                    android:paddingHorizontal="18dp" android:background="@drawable/input_modern"
                    android:layout_marginBottom="20dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Password" android:textSize="13sp" android:textColor="#6C63FF"
                    android:textStyle="bold" android:paddingBottom="8dp"/>
                <EditText android:id="@+id/etPassword" android:layout_width="match_parent" android:layout_height="56dp"
                    android:hint="Min 6 characters" android:inputType="textPassword"
                    android:paddingHorizontal="18dp" android:background="@drawable/input_modern"
                    android:layout_marginBottom="28dp"/>
                <Button android:id="@+id/btnRegister" android:layout_width="match_parent" android:layout_height="58dp"
                    android:text="Create Account" android:background="@drawable/btn_purple" android:textColor="#FFFFFF"
                    android:textSize="16sp" android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
