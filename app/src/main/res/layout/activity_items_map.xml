<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <fragment
        android:id="@+id/mapFragment"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/gradient_header" android:padding="18dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="40dp" android:layout_height="40dp"
            android:background="@drawable/card_elevated" android:gravity="center" android:layout_marginEnd="14dp">
            <TextView android:id="@+id/btnBack" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="←" android:textSize="22sp" android:textColor="#1A1A2E"/>
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Map View" android:textSize="18sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
            <TextView android:id="@+id/tvMapItemCount" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Loading items..." android:textSize="12sp" android:textColor="#FFFFFFCC"/>
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
