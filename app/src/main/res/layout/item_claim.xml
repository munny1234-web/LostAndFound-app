<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/card_elevated" android:orientation="vertical"
    android:padding="18dp" android:elevation="2dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="8dp">
        <LinearLayout android:layout_width="44dp" android:layout_height="44dp"
            android:background="@drawable/chip_default" android:gravity="center" android:layout_marginEnd="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="📋" android:textSize="22sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tvClaimTitle" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="15sp"
                android:textStyle="bold" android:textColor="#1A1A2E"/>
            <TextView android:id="@+id/tvClaimReason" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="12sp"
                android:textColor="#888" android:paddingTop="2dp"/>
        </LinearLayout>
        <TextView android:id="@+id/tvClaimStatus" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold"
            android:textColor="#6C63FF" android:background="@drawable/chip_default"
            android:paddingHorizontal="10dp" android:paddingVertical="4dp"/>
    </LinearLayout>

    <TextView android:id="@+id/tvClaimDate" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#C4BEFF"/>

</LinearLayout>
