<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#F5F4FF">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/gradient_header" android:padding="22dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="40dp" android:layout_height="40dp"
            android:background="@drawable/card_elevated" android:gravity="center" android:layout_marginEnd="14dp">
            <TextView android:id="@+id/btnBack" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="←" android:textSize="22sp" android:textColor="#1A1A2E"/>
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="My Posts" android:textSize="22sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Manage your reports" android:textSize="12sp" android:textColor="#FFFFFFCC"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="#FFFFFF" android:orientation="horizontal"
        android:paddingHorizontal="16dp" android:paddingVertical="12dp" android:elevation="2dp">
        <Button android:id="@+id/btnAllPosts" android:layout_width="0dp" android:layout_height="42dp"
            android:layout_weight="1" android:text="All" android:background="@drawable/btn_purple"
            android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:layout_marginEnd="6dp"/>
        <Button android:id="@+id/btnLostPosts" android:layout_width="0dp" android:layout_height="42dp"
            android:layout_weight="1" android:text="Lost" android:backgroundTint="#FFF0F0"
            android:textColor="#FF4444" android:textSize="12sp" android:textStyle="bold" android:layout_marginEnd="6dp"/>
        <Button android:id="@+id/btnFoundPosts" android:layout_width="0dp" android:layout_height="42dp"
            android:layout_weight="1" android:text="Found" android:backgroundTint="#F0FFF4"
            android:textColor="#2ECC71" android:textSize="12sp" android:textStyle="bold"/>
    </LinearLayout>
    <ListView android:id="@+id/listMyPosts" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:padding="12dp"
        android:divider="@android:color/transparent" android:dividerHeight="10dp"/>
</LinearLayout>
