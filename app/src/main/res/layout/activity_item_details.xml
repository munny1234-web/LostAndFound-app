<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#F5F4FF">

    <FrameLayout android:layout_width="match_parent" android:layout_height="240dp">
        <ImageView android:id="@+id/imgItem" android:layout_width="match_parent"
            android:layout_height="match_parent" android:scaleType="centerCrop" android:background="#E0DDFF"/>
        <HorizontalScrollView android:id="@+id/scrollGallery" android:layout_width="match_parent" android:layout_height="match_parent"
            android:visibility="gone" android:scrollbars="none">
            <LinearLayout android:id="@+id/layoutGallery" android:layout_width="wrap_content"
                android:layout_height="match_parent" android:orientation="horizontal"/>
        </HorizontalScrollView>
        <TextView android:id="@+id/tvPhotoCount" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="bottom|end" android:layout_margin="12dp" android:background="@drawable/card_elevated"
            android:paddingHorizontal="10dp" android:paddingVertical="4dp" android:textSize="11sp"
            android:textStyle="bold" android:textColor="#14142B" android:visibility="gone"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
            <LinearLayout android:layout_width="40dp" android:layout_height="40dp"
                android:background="@drawable/card_elevated" android:gravity="center">
                <TextView android:id="@+id/btnBack" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="←" android:textSize="22sp" android:textColor="#1A1A2E"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/card_elevated" android:orientation="vertical"
                android:padding="20dp" android:elevation="3dp" android:layout_marginBottom="12dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="14dp">
                    <TextView android:id="@+id/tvType" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="LOST" android:textSize="12sp" android:textStyle="bold" android:textColor="#FF4444"
                        android:background="@drawable/tag_lost" android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp" android:layout_marginEnd="10dp"/>
                    <TextView android:id="@+id/tvStatusBadge" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="11sp" android:textStyle="bold" android:textColor="#17A45C"
                        android:background="@drawable/tag_resolved" android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp" android:layout_marginEnd="8dp" android:visibility="gone"/>

                    <TextView android:id="@+id/tvCategory" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:textSize="12sp" android:textColor="#9B8EC4"
                        android:background="@drawable/chip_default" android:paddingHorizontal="10dp" android:paddingVertical="4dp"/>
                    <TextView android:id="@+id/tvReward" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="13sp"
                        android:textStyle="bold" android:textColor="#FF6584"/>
                </LinearLayout>

                <TextView android:id="@+id/tvTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="24sp" android:textStyle="bold" android:textColor="#1A1A2E" android:paddingBottom="10dp"/>
                <TextView android:id="@+id/tvDescription" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="14sp" android:textColor="#555" android:lineSpacingMultiplier="1.6" android:paddingBottom="16dp"/>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#E0DDFF" android:layout_marginBottom="14dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingBottom="10dp">
                    <LinearLayout android:layout_width="36dp" android:layout_height="36dp"
                        android:background="@drawable/chip_default" android:gravity="center" android:layout_marginEnd="10dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📍" android:textSize="16sp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Location" android:textSize="11sp" android:textColor="#9B8EC4"/>
                        <TextView android:id="@+id/tvLocation" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textSize="14sp"
                            android:textStyle="bold" android:textColor="#1A1A2E"/>
                    </LinearLayout>
                    <TextView android:id="@+id/tvViewOnMap" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🗺️ View on Map" android:textSize="12sp" android:textColor="#6C63FF" android:textStyle="bold"
                        android:layout_marginStart="14dp" android:visibility="gone"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="36dp" android:layout_height="36dp"
                        android:background="@drawable/chip_default" android:gravity="center" android:layout_marginEnd="10dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📅" android:textSize="16sp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Date" android:textSize="11sp" android:textColor="#9B8EC4"/>
                        <TextView android:id="@+id/tvDate" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textSize="14sp"
                            android:textStyle="bold" android:textColor="#1A1A2E"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ML Smart Matches -->
            <LinearLayout android:id="@+id/layoutMatches" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:background="@drawable/card_elevated"
                android:orientation="vertical" android:padding="20dp" android:elevation="3dp"
                android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="12dp">
                    <LinearLayout android:layout_width="44dp" android:layout_height="44dp"
                        android:background="@drawable/chip_selected" android:gravity="center" android:layout_marginEnd="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="🤖" android:textSize="22sp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="AI Smart Matching" android:textSize="16sp"
                            android:textStyle="bold" android:textColor="#1A1A2E"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Text + Image similarity" android:textSize="11sp" android:textColor="#9B8EC4"/>
                    </LinearLayout>
                    <ProgressBar android:id="@+id/progressMatches" android:layout_width="24dp"
                        android:layout_height="24dp" android:indeterminateTint="#6C63FF" android:visibility="gone"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#E0DDFF" android:layout_marginBottom="12dp"/>
                <TextView android:id="@+id/tvMatches" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="🤖 AI is finding matches..."
                    android:textSize="13sp" android:textColor="#555" android:lineSpacingMultiplier="1.8"/>
                <LinearLayout android:id="@+id/layoutMatchCards" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="8dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Action Buttons -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="8dp">
            <Button android:id="@+id/btnChat" android:layout_width="0dp" android:layout_height="52dp"
                android:layout_weight="1" android:text="💬 Chat" android:background="@drawable/btn_purple"
                android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:layout_marginEnd="6dp"/>
            <Button android:id="@+id/btnCall" android:layout_width="0dp" android:layout_height="52dp"
                android:layout_weight="1" android:text="📞 Call" android:background="@drawable/gradient_found"
                android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:layout_marginEnd="6dp"/>
            <Button android:id="@+id/btnShare" android:layout_width="0dp" android:layout_height="52dp"
                android:layout_weight="1" android:text="📤 Share" android:backgroundTint="#F0EEFF"
                android:textColor="#6C63FF" android:textSize="13sp" android:textStyle="bold"/>
        </LinearLayout>

        <Button android:id="@+id/btnClaim" android:layout_width="match_parent" android:layout_height="52dp"
            android:text="📋 This is Mine — Claim It!" android:background="@drawable/chip_selected"
            android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"
            android:visibility="gone" android:layout_marginBottom="6dp"/>

        <Button android:id="@+id/btnStatus" android:layout_width="match_parent" android:layout_height="52dp"
            android:text="📋 Update Status" android:backgroundTint="#F0EEFF"
            android:textColor="#6C63FF" android:textSize="14sp" android:textStyle="bold"
            android:visibility="gone" android:layout_marginBottom="6dp"/>

        <Button android:id="@+id/btnReviewClaims" android:layout_width="match_parent" android:layout_height="52dp"
            android:text="📋 Review Claims" android:background="@drawable/btn_purple"
            android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"
            android:visibility="gone" android:layout_marginBottom="6dp"/>

        <Button android:id="@+id/btnReport" android:layout_width="match_parent" android:layout_height="44dp"
            android:text="⚠️ Report Post" android:backgroundTint="#FFF0F0"
            android:textColor="#FF4444" android:textSize="12sp" android:textStyle="bold"
            android:visibility="gone"/>
    </LinearLayout>

</LinearLayout>
