<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#1A1A2E">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="32dp">
        <LinearLayout android:layout_width="80dp" android:layout_height="80dp"
            android:background="@drawable/card_elevated" android:gravity="center"
            android:layout_marginBottom="20dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="⚙️" android:textSize="36sp"/>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Admin Access" android:textSize="26sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Authorized personnel only" android:textSize="13sp"
            android:textColor="#FFFFFF88" android:paddingTop="6dp"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.3">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="#FFFFFF" android:padding="28dp"
            android:layout_margin="16dp" android:elevation="4dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Admin Email" android:textSize="13sp" android:textColor="#6C63FF"
                android:textStyle="bold" android:paddingBottom="8dp"/>
            <EditText android:id="@+id/etAdminEmail" android:layout_width="match_parent" android:layout_height="56dp"
                android:hint="admin@example.com" android:inputType="textEmailAddress"
                android:paddingHorizontal="18dp" android:background="@drawable/input_modern"
                android:textSize="15sp" android:layout_marginBottom="20dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Admin Password" android:textSize="13sp" android:textColor="#6C63FF"
                android:textStyle="bold" android:paddingBottom="8dp"/>
            <EditText android:id="@+id/etAdminPassword" android:layout_width="match_parent" android:layout_height="56dp"
                android:hint="••••••••" android:inputType="textPassword"
                android:paddingHorizontal="18dp" android:background="@drawable/input_modern"
                android:textSize="15sp" android:layout_marginBottom="20dp"/>
            <Button android:id="@+id/btnAdminLoginSubmit" android:layout_width="match_parent" android:layout_height="58dp"
                android:text="Enter Admin Panel" android:background="@drawable/btn_purple" android:textColor="#FFFFFF"
                android:textSize="16sp" android:textStyle="bold" android:layout_marginBottom="14dp"/>
            <TextView android:id="@+id/btnBackToUserLogin" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="← Back to regular login"
                android:textSize="13sp" android:textColor="#888" android:layout_gravity="center"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
