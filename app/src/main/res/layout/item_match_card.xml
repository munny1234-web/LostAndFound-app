<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/input_modern" android:padding="12dp"
    android:layout_marginBottom="10dp">

    <ImageView android:id="@+id/imgMatchThumb" android:layout_width="60dp" android:layout_height="60dp"
        android:scaleType="centerCrop" android:background="@drawable/chip_default" android:layout_marginEnd="12dp"/>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tvMatchScore" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="⚡ Moderate Match (44%)" android:textSize="11sp" android:textColor="#6C63FF" android:textStyle="bold"/>
        <TextView android:id="@+id/tvMatchTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Item title" android:textSize="14sp" android:textStyle="bold" android:textColor="#1A1A2E"
            android:paddingTop="2dp"/>
        <TextView android:id="@+id/tvMatchMeta" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="📂 Category   📍 Location" android:textSize="11sp" android:textColor="#888" android:paddingTop="2dp"/>
    </LinearLayout>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="›" android:textSize="22sp" android:textColor="#CCCCCC" android:paddingStart="8dp"/>
</LinearLayout>
